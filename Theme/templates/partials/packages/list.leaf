<!-- A package category page. `category` and `showcaseYears` come from PageContext. -->
<section class="package-list">
  <nav>
    <a href="/packages/#package-ecosystem" rel="parent">Explore the Swift package ecosystem</a>
  </nav>

  #markdown(category.description)

  #if(category.isShowcase):
  #extend("partials/packages/get-involved")
  #endif

  <ul>
    #for(package in category.packages):
    #extend("partials/packages/package", package)
    #endfor
  </ul>

  #if(category.more):
  <a class="cta-secondary" href="#(category.more.url)" target="_blank">#(category.more.title) &rsaquo;</a>
  #endif
</section>

#if(category.isShowcase):
<h2 id="archive">Archive</h2>
<p>
  The Community Showcase <a href="/blog/packages-page/">launched in November 2023</a> and features a
  new set of packages every month. Browse the archive below to see the history of featured Community Showcase packages:
</p>
<div class="interactive-tabs">
  <div class="tabs">
    #for(year in showcaseYears):
    <button aria-pressed="#if(year.isFirst):true#else:false#endif">#(year.year)</button>
    #endfor
  </div>
  #for(year in showcaseYears):
  <ul class="content #if(year.isFirst):active#endif" data-tab="#(year.year)">
    #for(month in year.months):
    <li>
      <a href="#(month.url)">#(month.month)</a>
    </li>
    #endfor
  </ul>
  #endfor
</div>
#endif
