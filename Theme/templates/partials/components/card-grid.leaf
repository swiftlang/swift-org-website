<div class="section card-grid">
<div class="content">
<h2>#(content.title)</h2>
#if(content.hero_card):
<div class="hero-card">
<img src="#(content.hero_card.url)" alt="#(content.hero_card.alt)" />
</div>
#endif
#if(content.primary_cards):
<ul class="primary-cards">
#for(card in content.primary_cards):
<li>
<img src="#(card.logo)" alt="#(card.logo_alt)" />
<div>
<span class="name">#(card.name)</span>
<span class="text">#unsafeHTML(card.text)</span>
<a href="#(card.link)">#(card.link_text)</a>
</div>
</li>
#endfor
</ul>
#endif
#if(content.secondary_cards):
<ul class="secondary-cards">
#for(card in content.secondary_cards):
<li>
<img src="#(card.logo)" alt="#(card.logo_alt)" />
<div>
<span class="name">#(card.name)</span>
<span class="text">#unsafeHTML(card.text)</span>
<a href="#(card.link)">#(card.link_text)</a>
</div>
</li>
#endfor
</ul>
#endif
#if(content.tertiary_cards):
<ul class="tertiary-cards">
#for(card in content.tertiary_cards):
<li>
#if(card.image):
<img src="#(card.image.url)" alt="#(card.image.alt)" />
#endif
<div>
<span class="name">#(card.name)</span>
<span class="text">#unsafeHTML(card.text)</span>
<a href="#(card.link)">#(card.link_text)</a>
</div>
</li>
#endfor
</ul>
#endif
#if(content.text):
<p>#unsafeHTML(content.text)</p>
#endif
#if(content.link):
<a href="#(content.link.url)">#(content.link.text)
</a>
#endif
</div>
</div>
