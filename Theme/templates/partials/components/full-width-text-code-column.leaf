<div class="full-width-text-code-column content-wrapper#if(background): background#endif">
<div class="text-wrapper">
<h2>#(content.headline)</h2>
#for(paragraph in content.paragraphs):
<p class="body-copy">#unsafeHTML(paragraph)</p>
#endfor
#if(content.link):
<a class="body-copy" href="#(content.link.url)">#(content.link.text)
</a>
#endif
</div>
<div class="code body-copy">#swiftCode(content.code)</div>
</div>
