<!-- `_includes/install/_older-releases.md`. Context: `rows`, `isWindows`. -->
<table id="osx-builds" class="downloads body-copy">
<thead>
<tr>
<th class="download">Release</th>
<th class="download">Date</th>
<th class="download">Toolchain</th>
<th class="download">Docker</th>
#if(!isWindows):
<th class="download">Static SDK</th>
#endif
</tr>
</thead>
<tbody>
#for(row in rows):
<tr>
<td>
Swift #(row.name)#if(row.footnote):<sup> 1</sup>#endif
</td>
<td>
#(row.date)
</td>
<td class="arch-tag">
#for(arch in row.archs):
<a href="#(arch.download)">#(arch.arch)</a>
#if(arch.signature):
<a href="#(arch.signature)" title="PGP Signature" class="signature">Signature (#(arch.arch))</a>
#endif
#endfor
</td>
<td class="docker-tag">
#if(row.docker):
<a href="https://hub.docker.com/_/swift/?tab=tags">#(row.docker)</a>
#else:
Unavailable
#endif
</td>
#if(!row.isWindows):
<td class="docker-tag">
#if(row.staticSDKCommand):
<button onclick="copyToClipboard(this, '#(row.staticSDKCommand)')">Copy install command</button>
#else:
Unavailable
#endif
</td>
#endif
</tr>
#endfor
</tbody>
</table>
