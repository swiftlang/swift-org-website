<!-- `install/macos/_older-releases.md`: the Xcode toolchain archive. -->
<table id="osx-builds" class="downloads body-copy">
<thead>
<tr>
<th class="download">Release</th>
<th class="download">Date</th>
<th class="download">Toolchain</th>
<th class="download">Debugging Symbols</th>
<th class="download">Static SDK</th>
</tr>
</thead>
<tbody>
#for(row in rows):
<tr>
<td>Swift #(row.name)</td>
<td>#(row.date)</td>
<td class="">
<span class="release"><a href="#(row.toolchain)" title="Toolchain">Toolchain</a></span>
</td>
<td class="">
<span class="release"><a href="#(row.symbols)" title="Debugging Symbols">Debugging Symbols</a></span>
</td>
<td class="release">
#if(row.staticSDKCommand):
<button onclick="copyToClipboard(this, '#(row.staticSDKCommand)')">Copy install command</button>
#else:
Unavailable
#endif
</td>
</tr>
#endfor
</tbody>
</table>
