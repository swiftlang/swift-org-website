#extend("base-classic"):
#export("content"):
<article class="page">
  #if(page.frontMatter.hideTitle):#else:
  <header>
    <h1>#(page.title)</h1>
  </header>
  #endif

  #unsafeHTML(page.content)

  #if(page.frontMatter.authors):
  <footer>
    <p>Contributed by</p>
    #unsafeHTML(component("authors"))
  </footer>
  #endif
</article>
#endexport
#endextend
