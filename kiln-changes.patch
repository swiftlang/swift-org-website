--- /private/tmp/claude-501/-Users-timc-Developer-Swiftlang-swift-org-website/574eb770-6807-4c3d-8a12-40328b7f0465/scratchpad/kiln-base/Sources/Kiln/Rendering/MarkdownTag.swift	1970-01-01 01:00:00
+++ .kiln/Sources/Kiln/Rendering/MarkdownTag.swift	2026-08-29 03:10:52
@@ -0,0 +1,21 @@
+import LeafKit
+
+/// `#markdown("…")` — render a markdown string to HTML inside a template.
+///
+/// Data-driven pages often hold prose in YAML (a package description, a callout
+/// body) that has to reach the page as HTML. This renders it with the same
+/// ``MarkdownRenderer`` the page bodies use, so the markup matches.
+///
+/// The result is HTML and must not be escaped again, hence
+/// `UnsafeUnescapedLeafTag` — it can be emitted with `#markdown(...)` directly
+/// rather than needing `#unsafeHTML(...)` around it.
+struct MarkdownTag: UnsafeUnescapedLeafTag {
+    let renderer: MarkdownRenderer
+
+    func render(_ ctx: LeafContext) throws -> LeafData {
+        guard let source = ctx.parameters.first?.string, !source.isEmpty else {
+            return .string("")
+        }
+        return .string(renderer.render(source).html)
+    }
+}
