+++ .kiln/Sources/Kiln/Rendering/InMemoryLeafSource.swift	2026-08-29 03:00:30
@@ -0,0 +1,33 @@
+import LeafKit
+import NIOConcurrencyHelpers
+import NIOCore
+
+/// A `LeafSource` backed by strings held in memory.
+///
+/// Kiln uses this for *content templating*: a page's markdown body is itself a
+/// Leaf template, so it has to reach `LeafRenderer`, which only resolves
+/// templates by path. The body is stored here under a per-page key and rendered
+/// through the normal pipeline, so content gets the same tags, partials and
+/// context as any template.
+///
+/// Keys are unique per page, which keeps Leaf's AST cache correct.
+final class InMemoryLeafSource: LeafSource, @unchecked Sendable {
+    private let lock = NIOLock()
+    private var templates: [String: String] = [:]
+
+    func store(_ contents: String, at key: String) {
+        lock.withLock { templates[key] = contents }
+    }
+
+    func file(template: String, escape: Bool, on eventLoop: any EventLoop) throws -> EventLoopFuture<ByteBuffer> {
+        // LeafKit may hand us the key with or without its extension.
+        let key = template.hasSuffix(".leaf") ? String(template.dropLast(5)) : template
+        guard let contents = lock.withLock({ templates[key] }) else {
+            // Not ours — let the next source in the layer try.
+            return eventLoop.makeFailedFuture(LeafError(.noTemplateExists(template)))
+        }
+        var buffer = ByteBufferAllocator().buffer(capacity: contents.utf8.count)
+        buffer.writeString(contents)
+        return eventLoop.makeSucceededFuture(buffer)
+    }
+}
